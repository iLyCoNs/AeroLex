{
  "name": "aerolex-github-cron",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {},
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [{ "name": "PASS_SCHEDULER", "class_name": "PassScheduler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PassScheduler"] }],
  "triggers": {
    "crons": []
  }
}
